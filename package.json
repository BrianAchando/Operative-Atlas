{
  "name": "surgical-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/content-build.mjs && vite --port 5174",
    "build": "node scripts/content-build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "data": "python pipeline/build.py && python pipeline/procedures.py && node scripts/content-export.mjs && node scripts/content-build.mjs && node scripts/mcq-check.mjs",
    "content": "node scripts/content-build.mjs",
    "mcq": "node scripts/mcq-check.mjs --list",
    "steps": "uv run --project pipeline python pipeline/procedures.py && node scripts/content-export.mjs && node scripts/content-build.mjs && node scripts/mcq-check.mjs"
  },
  "dependencies": {
    "@cornerstonejs/codec-openjpeg": "^1.3.6",
    "dicom-parser": "1.8.21",
    "fflate": "^0.8.3",
    "jpeg-lossless-decoder-js": "^2.1.2",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.0",
    "@types/three": "0.185.4",
    "marked": "^18.1.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
